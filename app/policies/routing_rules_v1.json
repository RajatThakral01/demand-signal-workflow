{
  "routing_rules_version": "1.0",
  "_comment": "Ordered routing rule table (FR-7). Rules evaluated top-to-bottom; first match wins. Fallback fires when no rule matches. rule_matched is recorded on every route including the fallback.",
  "rules": [
