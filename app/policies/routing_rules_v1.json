      "sla_hours": 2
    },
    {
      "name": "warm_pricing",
      "condition": { "decision": "warm", "label": "pricing_inquiry" },
      "queue": "sales_priority",
      "sla_hours": 8
    },
    {
      "name": "warm_any",
      "condition": { "decision": "warm" },
      "queue": "sales_default",
      "sla_hours": 24
    },
    {
      "name": "needs_review_any",
      "condition": { "decision": "needs_review" },
      "queue": "manual_queue",
      "sla_hours": 48
    },
    {
      "name": "cold_any",
      "condition": { "decision": "cold" },
      "queue": "nurture",
      "sla_hours": 72
    }
  ],
  "fallback": {
    "queue": "unassigned",
    "rule_matched": "fallback_no_rule",
