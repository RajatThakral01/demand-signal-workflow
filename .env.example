# ============================================================================
# Demand-Signal Workflow — environment variable reference
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored — NEVER commit it. Only this .env.example (names only,
# no values) lives in version control.
#
# All variables are read via pydantic-settings in app/config.py.
# The Docker image supplies safe LOCAL-ONLY defaults for everything not set,
# so `docker compose up` works with a bare copy of this file.
# ============================================================================

# Database connection string (PostgreSQL 15+). Used by SQLAlchemy async engine.
# In docker compose this points at the `db` service (see docker-compose.yml).
DATABASE_URL=

# OpenRouter API key for the LIVE classification call (interpretation stage,
# Phase 3). Empty locally until Rajat drops his real key in .env — never commit
# real keys.
OPENROUTER_API_KEY=

# Groq API key for the alternative LIVE classification call (when
# LLM_PROVIDER=groq). Get a key at console.groq.com — distinct from
# OPENROUTER_API_KEY, do not reuse that field name for a Groq key.
GROQ_API_KEY=

# LLM provider for the LIVE classification call — "openrouter" (default,
# via OpenRouter) or "groq" (via api.groq.com). Both use the OpenAI-
# compatible chat.completions API; switching is a provider-abstraction.
LLM_PROVIDER=openrouter

# Pinned OpenRouter model identifier for classification.
# DELIBERATE DEVIATION from the PRD's example string (anthropic/claude-haiku-4.5):
# we use the materially cheaper DeepSeek V4 Flash (`deepseek/deepseek-v4-flash`)
# for repeated test runs. PRD FR-4 and `interpretations.model_version` are
# provider/model-agnostic by design, so no PRD change is required — only this
# disclosure. See AI_USAGE.md.
CLASSIFICATION_MODEL=deepseek/deepseek-v4-flash

# Static bearer token for /api/v1/admin/* endpoints (replay, simulate-failure).
ADMIN_API_KEY=

# Active versioned policy files (file basenames under app/policies/).
SCORING_POLICY_VERSION=
IDENTITY_POLICY_VERSION=

# Logging level (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=

# Runtime environment: local / test.
APP_ENV=

# Bounded retry configuration for transient provider failures (FR-11).
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=500

# Minimum free-text length (in tokens) before the LLM is called (FR-4).
# Default is 2: pure noise like "hi" is skipped as unknown without a call;
# short but real intent like "want a quote" (3 words) does call the LLM.
# At ~$0.000026/call, dropping real short messages is not worth the saving.
INTERPRET_MIN_TOKENS=2
